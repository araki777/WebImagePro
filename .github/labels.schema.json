{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "color": {
        "type": "string",
        "pattern": "^#?[0-9a-fA-F]{6}$"
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": {
        "type": "string"
      },
      "deleted": {
        "type": "boolean"
      }
    },
    "required": ["name", "color", "aliases", "description", "deleted"]
  }
}